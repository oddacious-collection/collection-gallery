{
  "name": "collection-gallery",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=26.0.0 <27",
    "npm": ">=11.10.0"
  },
  "scripts": {
    "dev:public": "npm run dev -w @cg/public",
    "dev:admin": "npm run dev -w @cg/admin",
    "build": "npm run build -w @cg/public && npm run build -w @cg/admin",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p packages/core --noEmit && npm run typecheck -w @cg/public && npm run typecheck -w @cg/admin && tsc -p tsconfig.tools.json --noEmit",
    "test": "npm run test -w @cg/core",
    "test:e2e": "playwright test",
    "check:bundle": "node scripts/check-public-bundle.ts",
    "db:generate": "npm run db:generate -w @cg/core",
    "db:migrate:local": "npm run db:migrate:local -w @cg/admin",
    "db:migrate:staging": "npm run db:migrate:staging -w @cg/admin",
    "deploy:staging": "npm run deploy:staging -w @cg/public && npm run deploy:staging -w @cg/admin",
    "smoke:staging": "node scripts/smoke-staging.ts",
    "backup:verify": "node -e \"console.error('backup:verify is implemented in M1 (BAK-08)'); process.exit(1)\""
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "eslint": "10.15.0",
    "eslint-plugin-astro": "3.2.1",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "wrangler": "4.162.0"
  }
}
