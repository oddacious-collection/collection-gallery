---
import { env } from 'cloudflare:workers';
import {
  DomainError,
  getItem,
  countInbox,
  listItemMedia,
  listCategoryTree,
  publishBlockers,
  type CategoryNode,
} from '@cg/core/admin';
import Admin from '../../../layouts/Admin.astro';
import CategoryChecks from '../../../components/CategoryChecks.astro';
import { LICENSE_LABEL, STATUS_LABEL, centsToInput, shortDateTime } from '../../../lib/format.ts';

const id = String(Astro.params['id']);
let item;
try {
  item = await getItem(env.DB, id);
} catch (err) {
  if (err instanceof DomainError && err.code === 'not_found') {
    return new Response(null, { status: 404 });
  }
  throw err;
}
const [tree, blockers, photos, inboxCount] = await Promise.all([
  listCategoryTree(env.DB),
  publishBlockers(env.DB, id),
  listItemMedia(env.DB, id),
  countInbox(env.DB),
]);
/** Thumbnail size within a square box, aspect kept. */
/** 83 → "1:23". */
const clock = (s: number) => {
  const t = Math.round(s);
  return `${Math.floor(t / 60)}:${String(t % 60).padStart(2, '0')}`;
};
const fit = (p: { width: number; height: number }, box: number) =>
  p.width >= p.height
    ? { width: box, height: Math.max(1, Math.round((box * p.height) / p.width)) }
    : { width: Math.max(1, Math.round((box * p.width) / p.height)), height: box };
const byParent = new Map<string | null, CategoryNode[]>();
for (const node of tree) {
  const list = byParent.get(node.parentId) ?? [];
  list.push(node);
  byParent.set(node.parentId, list);
}
const selected = new Set(item.categoryIds);
const trashed = item.deletedAt !== null;
const isPublic = item.status === 'public' && item.kind === 'owned' && !trashed;
const suggestions: string[] = item.suggestedTags
  ? (JSON.parse(item.suggestedTags) as string[])
  : [];
const unusedSuggestions = suggestions.filter(
  (s) => !item.tagNames.some((t) => t.toLowerCase() === s.toLowerCase()),
);
const REASON: Record<string, string> = {
  needs_category: 'Add at least one category.',
  needs_media: 'Add at least one photo.',
  wishlist: 'Wishlist items can never be public.',
  in_trash: 'Restore it from the trash first.',
};
---

<Admin title={`${item.title} · Admin`}>
  <p>
    <a href="/items">← Items</a>
  </p>
  <h1>{item.title}</h1>

  <section class={`card status-box ${isPublic ? 'public' : ''}`} aria-labelledby="visibility">
    <h2 id="visibility">
      Visibility:{' '}
      {trashed ? (
        <span class="badge trash">In trash</span>
      ) : item.kind === 'wishlist' ? (
        <span class="badge wishlist">Wishlist</span>
      ) : (
        <span class={`badge ${item.status}`}>{STATUS_LABEL[item.status]}</span>
      )}
    </h2>
    <p class="hint">
      {isPublic
        ? `Visible to everyone. First published ${shortDateTime(item.postedAt)}.`
        : 'Only you can see this item.'}
    </p>
    {!isPublic && blockers.length > 0 && (
      <ul data-blockers>
        {blockers.map((b) => (
          <li data-blocker={b}>{REASON[b] ?? b}</li>
        ))}
      </ul>
    )}
    {!isPublic && blockers.length === 0 && (
      <p class="hint">
        Before publishing: check alt text, and that no faces, addresses, receipts or other personal
        details are visible in the photos.
      </p>
    )}
    {!trashed && item.kind === 'owned' && (
      <div class="actions">
        {isPublic ? (
          <button
            class="primary"
            data-api={`/api/items/${id}/status`}
            data-body='{"status":"private"}'
          >
            Make private
          </button>
        ) : (
          <button
            class="primary"
            data-api={`/api/items/${id}/status`}
            data-body='{"status":"public"}'
            disabled={blockers.length > 0}
            data-publish
            data-then="redirect:/items?published={id}"
          >
            Publish
          </button>
        )}
        {item.status !== 'draft' && (
          <button data-api={`/api/items/${id}/status`} data-body='{"status":"draft"}'>
            Back to draft
          </button>
        )}
      </div>
    )}
  </section>

  <form class="card" data-api={`/api/items/${id}`} data-method="PATCH" data-label="Details">
    <h2>Details</h2>
    <label for="title">Title</label>
    <input id="title" name="title" type="text" required maxlength="200" value={item.title} />
    <label for="description">Description</label>
    <textarea
      id="description"
      name="description"
      maxlength="20000"
      set:text={item.description}
    ></textarea>
    <p class="hint">
      Plain text with simple formatting: *italic*, **bold**, lists, links, ## headings.
    </p>
    <div class="row">
      <div>
        <label for="slug">URL name</label>
        <input
          id="slug"
          name="slug"
          type="text"
          maxlength="80"
          pattern="[a-z0-9]+(-[a-z0-9]+)*"
          value={item.slug}
        />
        <p class="hint">Changing it keeps the old link working.</p>
      </div>
      <div>
        <label for="postedAt">Posted at (UTC)</label>
        <input
          id="postedAt"
          name="postedAt"
          type="text"
          data-type="nullable"
          placeholder="2026-11-23T19:04:00.000Z"
          value={item.postedAt ?? ''}
        />
        <p class="hint">Set automatically on first publish.</p>
      </div>
    </div>
    <div class="row">
      <div>
        <label for="kind">Kind</label>
        <select id="kind" name="kind">
          <option value="owned" selected={item.kind === 'owned'}>
            In my collection
          </option>
          <option value="wishlist" selected={item.kind === 'wishlist'}>
            Wishlist (never public)
          </option>
        </select>
      </div>
      <div>
        <label for="licenseOverride">License</label>
        <select id="licenseOverride" name="licenseOverride" data-type="nullable">
          <option value="" selected={item.licenseOverride === null}>
            Inherit from category / site
          </option>
          {Object.entries(LICENSE_LABEL).map(([value, label]) => (
            <option value={value} selected={item.licenseOverride === value}>
              {label}
            </option>
          ))}
        </select>
      </div>
      <div>
        <label for="watermarkOverride">Watermark</label>
        <select id="watermarkOverride" name="watermarkOverride">
          <option value="inherit" selected={item.watermarkOverride === 'inherit'}>
            Site setting
          </option>
          <option value="on" selected={item.watermarkOverride === 'on'}>
            On
          </option>
          <option value="off" selected={item.watermarkOverride === 'off'}>
            Off
          </option>
        </select>
      </div>
    </div>

    <h2>
      Private records <span class="hint">(never shown publicly)</span>
    </h2>
    <div class="row">
      <div>
        <label for="purchasePriceCents">Purchase price (USD)</label>
        <input
          id="purchasePriceCents"
          name="purchasePriceCents"
          type="text"
          inputmode="decimal"
          data-type="cents"
          value={centsToInput(item.purchasePriceCents)}
        />
      </div>
      <div>
        <label for="purchaseDate">Purchase date</label>
        <input
          id="purchaseDate"
          name="purchaseDate"
          type="date"
          data-type="nullable"
          value={item.purchaseDate ?? ''}
        />
      </div>
    </div>
    <label class="inline">
      <input type="checkbox" name="openToParting" data-type="bool" checked={item.openToParting} />
      Open to parting with
    </label>
    <p data-api-message role="status"></p>
    <div class="actions">
      <button class="primary" type="submit">
        Save details
      </button>
    </div>
  </form>

  <form
    class="card"
    data-api={`/api/items/${id}/categories`}
    data-method="PUT"
    data-category-form
    data-label="Categories"
    data-item-id={id}
  >
    <h2>Categories</h2>
    {tree.length === 0 ? (
      <>
        <p class="muted" data-no-categories>
          No categories yet. Create the first one below.
        </p>
        <ul class="checks tree" data-category-root></ul>
      </>
    ) : (
      <div data-category-root-wrap>
        <CategoryChecks byParent={byParent} parentId={null} selected={selected} />
      </div>
    )}
    <p class="hint">The item also appears in every parent category's listings.</p>
    <p data-api-message role="status"></p>
    <div class="actions">
      <button type="submit">Save categories</button>
    </div>

    <details class="new-category" data-new-category open={tree.length === 0}>
      <summary>+ New category</summary>
      <div class="row">
        <div>
          <label for="new-category-name">Name</label>
          <input id="new-category-name" type="text" maxlength="100" autocomplete="off" />
        </div>
        <div>
          <label for="new-category-parent">Inside</label>
          <select id="new-category-parent">
            <option value="">(top level)</option>
            {tree.map((c) => (
              <option value={c.id} data-depth={c.depth}>
                {`${' '.repeat(c.depth)}${c.name}`}
              </option>
            ))}
          </select>
        </div>
      </div>
      <p class="hint">
        Creates the category and adds this item to it straight away. Rename, move or reorder
        categories later on the <a href="/categories">Categories</a> page.
      </p>
      <p data-new-category-message role="status"></p>
      <div class="actions">
        <button type="button" data-new-category-create>
          Create and add
        </button>
      </div>
    </details>
  </form>

  <form class="card" data-api={`/api/items/${id}/tags`} data-method="PUT" data-label="Tags">
    <h2>Tags</h2>
    <label for="tags">Tags, separated by commas</label>
    <input id="tags" name="tags" type="text" data-type="list" value={item.tagNames.join(', ')} />
    {unusedSuggestions.length > 0 && (
      <>
        <p class="hint">
          Hashtags from the original Instagram post (private suggestions; click to add):
        </p>
        <div class="suggestions">
          {unusedSuggestions.map((s) => (
            <button type="button" class="small" data-add-tag={s}>
              + {s}
            </button>
          ))}
        </div>
      </>
    )}
    <p data-api-message role="status"></p>
    <div class="actions">
      <button type="submit">Save tags</button>
    </div>
  </form>

  <section class="card" id="photos" data-photos data-item-id={id} aria-labelledby="photos-h">
    <h2 id="photos-h">Photos and videos</h2>
    {photos.active.length === 0 ? (
      <p class="muted">No photos or videos yet.</p>
    ) : (
      <ol class="photos" data-item-id={id}>
        {photos.active.map((p, i) => (
          <li data-media-id={p.id}>
            {p.thumbKey ? (
              <img src={`/media/${p.thumbKey}`} {...fit(p, 160)} alt={p.altText || item.title} />
            ) : (
              <span class="muted">(no preview)</span>
            )}
            <div class="photo-tools">
              <p class="hint">
                {p.isCover ? (
                  <span class="badge public">Cover</span>
                ) : (
                  `${p.kind === 'video' ? 'Video' : 'Photo'} ${i + 1}`
                )}{' '}
                {p.kind === 'video' && p.durationS !== null && `· ${clock(p.durationS)} `}·{' '}
                {p.width}×{p.height}
              </p>
              <form
                data-api={`/api/media/${p.id}`}
                data-method="PATCH"
                data-then="none"
                data-label={`Alt text (photo ${i + 1})`}
              >
                <label for={`alt-${p.id}`}>Alt text (describes the photo for screen readers)</label>
                <input
                  id={`alt-${p.id}`}
                  name="altText"
                  type="text"
                  maxlength="1000"
                  value={p.altText}
                  placeholder={`Blank uses the title: ${item.title}`}
                />
                <p data-api-message role="status"></p>
                <div class="actions">
                  <button type="submit" class="small">
                    Save alt text
                  </button>
                </div>
              </form>
              <div class="actions">
                {i > 0 && (
                  <button type="button" class="small" data-photo-move="first">
                    Make cover
                  </button>
                )}
                {i > 0 && (
                  <button
                    type="button"
                    class="small"
                    data-photo-move="up"
                    aria-label="Move earlier"
                  >
                    ↑
                  </button>
                )}
                {i < photos.active.length - 1 && (
                  <button
                    type="button"
                    class="small"
                    data-photo-move="down"
                    aria-label="Move later"
                  >
                    ↓
                  </button>
                )}
                <a class="small" href={`/media/original/${p.id}`} download>
                  Download original
                </a>
                <button
                  type="button"
                  class="small danger"
                  data-api={`/api/media/${p.id}`}
                  data-method="DELETE"
                  data-confirm="Remove this photo? You can restore it here for 30 days."
                >
                  Remove
                </button>
              </div>
            </div>
          </li>
        ))}
      </ol>
    )}
    {!trashed && (
      <>
        <label for="photo-input">Add photos</label>
        <input id="photo-input" type="file" accept="image/*" multiple data-photo-input />
        {inboxCount > 0 && (
          <p>
            <a href={`/inbox?for=${id}`}>Add from the inbox ({inboxCount} waiting)</a>
          </p>
        )}
        <p class="hint">
          On iPhone you can take a photo or choose from your library. Each photo is processed on
          this device first: rotated upright, and location, camera and date details removed. Only
          the cleaned copies are uploaded.
        </p>
        <ul class="photo-progress" data-photo-progress aria-live="polite"></ul>
        <div class="video-add" data-videos data-item-id={id}>
          <label for="video-input">Add a video</label>
          <input
            id="video-input"
            type="file"
            accept="video/mp4,video/quicktime,.mp4,.mov"
            data-video-input
          />
          <p class="hint">
            Up to 2 minutes. Processed on this device: location, device and date details are
            removed, and a web version is made. On iPhone, in the picker choose Options → Format →
            Current, or iOS sends a shrunk copy.
          </p>
          <div class="video-panel" data-video-panel hidden>
            <p data-video-info></p>
            <p class="warning" data-video-warning hidden></p>
            <fieldset>
              <legend>Poster (the picture shown before it plays)</legend>
              <canvas class="video-preview" data-video-preview aria-hidden="true"></canvas>
              <label class="scrub">
                <span>
                  Position <span data-video-time>0:00.0</span>
                </span>
                <input type="range" min="0" step="0.05" value="0" data-video-scrub />
              </label>
              <p class="video-buttons">
                <button type="button" data-video-use-poster>
                  Use this frame as the poster
                </button>
                <button type="button" data-video-set-start>
                  Set start here
                </button>
                <button type="button" data-video-set-end>
                  Set end here
                </button>
              </p>
              <p class="hint" data-video-poster-note>
                Poster: the first frame.
              </p>
              <p class="hint">Quick picks (tap one to jump there):</p>
              <div class="poster-choices" data-video-posters></div>
            </fieldset>
            <fieldset>
              <legend>Trim (seconds)</legend>
              <label>
                Start <input type="number" min="0" step="0.1" data-video-start />
              </label>
              <label>
                End <input type="number" min="0" step="0.1" data-video-end />
              </label>
              <p class="hint" data-video-length></p>
            </fieldset>
            <label>
              <input type="checkbox" data-video-mute /> Remove sound
            </label>
            <p>
              <button type="button" class="primary" data-video-upload>
                Process and upload
              </button>
              <button type="button" data-video-stop hidden>
                Stop
              </button>
            </p>
            <progress max="1" value="0" data-video-progress hidden></progress>
            <p aria-live="polite" data-video-status></p>
          </div>
        </div>
      </>
    )}
    {photos.removed.length > 0 && (
      <details>
        <summary>Removed photos ({photos.removed.length}, kept 30 days)</summary>
        <ul class="photos removed">
          {photos.removed.map((p) => (
            <li>
              {p.thumbKey && (
                <img src={`/media/${p.thumbKey}`} {...fit(p, 80)} alt={p.altText || item.title} />
              )}
              <span class="hint">Removed {shortDateTime(p.deletedAt)}</span>
              <button type="button" class="small" data-api={`/api/media/${p.id}/restore`}>
                Restore
              </button>
            </li>
          ))}
        </ul>
      </details>
    )}
  </section>

  <section class="card">
    <h2>History and trash</h2>
    <p>
      <a href={`/items/${id}/revisions`}>Revision history</a> · Created{' '}
      {shortDateTime(item.createdAt)}
    </p>
    <div class="actions">
      {trashed ? (
        <>
          <button data-api={`/api/items/${id}/trash`} data-body='{"trashed":false}'>
            Restore from trash
          </button>
          <button
            class="danger"
            data-api={`/api/items/${id}`}
            data-method="DELETE"
            data-then="redirect:/items?view=trash"
            data-confirm="Delete this item permanently, with its photos? This can't be undone here (backups keep a copy for a limited time)."
          >
            Delete permanently
          </button>
        </>
      ) : (
        <button
          class="danger"
          data-api={`/api/items/${id}/trash`}
          data-body='{"trashed":true}'
          data-confirm="Move this item to the trash? It disappears from the public site at once, and you can restore it for 30 days."
        >
          Move to trash
        </button>
      )}
    </div>
  </section>

  <div class="save-bar" data-save-bar>
    <p class="save-status" data-save-status role="status">
      All changes saved.
    </p>
    <div class="actions">
      <button type="button" data-save-all disabled>
        Save
      </button>
      <button type="button" class="primary" data-save-close data-href="/items">
        Save and close
      </button>
    </div>
  </div>
</Admin>

<script>
  import '../../../scripts/photos/upload.ts';
  import '../../../scripts/video/upload.ts';
  import '../../../scripts/new-category.ts';
</script>
