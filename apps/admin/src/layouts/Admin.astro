---
import '../styles/admin.css';
import { env } from 'cloudflare:workers';
import { countInbox, countReviewQueue } from '@cg/core/admin';

interface Props {
  title: string;
}
const { title } = Astro.props;
const path = Astro.url.pathname;
const view = Astro.url.searchParams.get('view');
const [inbox, toReview] = await Promise.all([countInbox(env.DB), countReviewQueue(env.DB)]);
const nav = [
  { href: '/items', label: 'Items', current: path === '/items' && view !== 'trash' },
  { href: '/items/new', label: 'New item', current: path === '/items/new' },
  {
    href: '/inbox',
    label: inbox > 0 ? `Inbox (${inbox})` : 'Inbox',
    current: path === '/inbox',
  },
  { href: '/categories', label: 'Categories', current: path === '/categories' },
  { href: '/import', label: 'Import', current: path === '/import' },
  ...(toReview > 0 || path.startsWith('/review')
    ? [
        {
          href: '/review',
          label: toReview > 0 ? `Review (${toReview})` : 'Review',
          current: path.startsWith('/review'),
        },
      ]
    : []),
  { href: '/items?view=trash', label: 'Trash', current: path === '/items' && view === 'trash' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
  </head>
  <body>
    <header class="topbar">
      <a class="brand" href="/items">
        Collection admin
      </a>
      <nav aria-label="Admin">
        {nav.map((n) => (
          <a href={n.href} aria-current={n.current ? 'page' : undefined}>
            {n.label}
          </a>
        ))}
      </nav>
    </header>
    <main>
      <p id="api-message" class="message" role="status" aria-live="polite"></p>
      <slot />
    </main>
    <script>
      import '../scripts/api.ts';
    </script>
  </body>
</html>
