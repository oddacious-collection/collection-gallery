---
/** Editable category tree for /categories (recursive). */
import type { CategoryNode } from '@cg/core/admin';

interface Props {
  byParent: Map<string | null, CategoryNode[]>;
  parentId: string | null;
  all: CategoryNode[];
  /** IDs under each category (itself included), to hide invalid move targets. */
  subtree: Map<string, Set<string>>;
}
const { byParent, parentId, all, subtree } = Astro.props;
const children = byParent.get(parentId) ?? [];
const indent = (depth: number) => ' '.repeat(depth);
---

{children.length > 0 && (
  <ul class="tree" data-parent-id={parentId ?? ''}>
    {children.map((c) => (
      <li data-category-id={c.id}>
        <div class="node">
          <strong>{c.name}</strong>
          <span class="hint">
            /{c.slug} · {c.itemCount} item{c.itemCount === 1 ? '' : 's'}
          </span>
          <button type="button" class="small" data-move="up" aria-label={`Move ${c.name} up`}>
            ↑
          </button>
          <button type="button" class="small" data-move="down" aria-label={`Move ${c.name} down`}>
            ↓
          </button>
        </div>
        <details>
          <summary>Edit {c.name}</summary>
          <form data-api={`/api/categories/${c.id}`} data-method="PATCH">
            <label for={`name-${c.id}`}>Name</label>
            <input
              id={`name-${c.id}`}
              name="name"
              type="text"
              required
              maxlength="100"
              value={c.name}
            />
            <label for={`slug-${c.id}`}>URL name</label>
            <input id={`slug-${c.id}`} name="slug" type="text" maxlength="80" value={c.slug} />
            <label for={`desc-${c.id}`}>Description</label>
            <textarea
              id={`desc-${c.id}`}
              name="description"
              maxlength="5000"
              set:text={c.description}
            />
            <p data-api-message role="status" />
            <div class="actions">
              <button type="submit">Save</button>
            </div>
          </form>
          <form data-api={`/api/categories/${c.id}/move`} data-method="POST">
            <label for={`move-${c.id}`}>Move under</label>
            <select id={`move-${c.id}`} name="parentId" data-type="nullable">
              <option value="" selected={c.parentId === null}>
                (top level)
              </option>
              {all
                .filter((o) => !(subtree.get(c.id)?.has(o.id) ?? false))
                .map((o) => (
                  <option value={o.id} selected={o.id === c.parentId}>
                    {indent(o.depth)}
                    {o.name}
                  </option>
                ))}
            </select>
            <p data-api-message role="status" />
            <div class="actions">
              <button type="submit">Move</button>
            </div>
          </form>
          <form data-api="/api/categories" data-method="POST">
            <input type="hidden" name="parentId" value={c.id} />
            <label for={`child-${c.id}`}>New subcategory of {c.name}</label>
            <input id={`child-${c.id}`} name="name" type="text" required maxlength="100" />
            <p data-api-message role="status" />
            <div class="actions">
              <button type="submit">Add subcategory</button>
              <button
                type="button"
                class="danger"
                data-api={`/api/categories/${c.id}`}
                data-method="DELETE"
                data-confirm={`Delete the category "${c.name}"? Only empty categories can be deleted.`}
              >
                Delete category
              </button>
            </div>
          </form>
        </details>
        <Astro.self byParent={byParent} parentId={c.id} all={all} subtree={subtree} />
      </li>
    ))}
  </ul>
)}
