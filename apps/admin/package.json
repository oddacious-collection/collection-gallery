{
  "name": "@cg/admin",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --port 4322",
    "build": "node ../../scripts/assert-build-env.ts && astro build",
    "preview": "astro preview --port 4322",
    "types": "wrangler types --include-runtime=false --strict-vars=false",
    "typecheck": "astro check",
    "deploy:staging": "node ../../scripts/deploy-staging.ts admin",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --config wrangler.jsonc --persist-to ../../.wrangler/state",
    "db:migrate:staging": "wrangler d1 migrations apply DB --remote --config wrangler.jsonc --env staging"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.6",
    "@cg/core": "*",
    "astro": "7.4.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "typescript": "6.0.3",
    "wrangler": "4.158.0"
  }
}
