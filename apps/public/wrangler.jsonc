// Public Worker (ARC-01). Serves the public site; in later milestones also
// media, likes, view beacons and the contact form — never admin routes.
//
// Least privilege (ARC-03): this Worker gets the database and the PUBLIC media
// bucket only. It has no binding to `media-private`.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // The top level is LOCAL DEVELOPMENT only (ENVIRONMENT=local, localhost
  // origins). It deliberately does not use the production name, so a bare
  // `wrangler deploy` can never overwrite production with local settings; it
  // would create an unreachable "-local" Worker (no workers.dev, no routes).
  // Staging and (from M7) production are explicit environments below.
  "name": "cg-public-local",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-28",
  "workers_dev": false,
  // Version/preview URLs are public by default — never enable them.
  "preview_urls": false,
  // PRV-04: invocation logs record request metadata; we only keep our own
  // structured logs, which never contain IPs or PII.
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } },
  "vars": {
    "ENVIRONMENT": "local",
    "PUBLIC_ORIGIN": "http://localhost:4321",
    "OWNER_NAME": "Insignificant Nobody",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cg-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/core/migrations",
    },
  ],
  "r2_buckets": [{ "binding": "MEDIA_PUBLIC", "bucket_name": "cg-media-public-local" }],

  "env": {
    "staging": {
      "name": "cg-public-staging",
      // Staging runs on workers.dev until the domain exists (D-21). Safe only
      // because Worker-level Access (all traffic) protects this Worker; never
      // turn that off (docs/runbooks/access-setup.md).
      "workers_dev": true,
      "preview_urls": false,
      "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } },
      "vars": {
        "ENVIRONMENT": "staging",
        "PUBLIC_ORIGIN": "SET_AT_DEPLOY",
        "OWNER_NAME": "Insignificant Nobody",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "cg-staging",
          "database_id": "f335c98e-69dd-4582-9559-dcb53587dfa4",
          "migrations_dir": "../../packages/core/migrations",
        },
      ],
      "r2_buckets": [{ "binding": "MEDIA_PUBLIC", "bucket_name": "cg-media-public-staging" }],
    },
  },
}
