{
  "name": "@cg/public",
  "private": true,
  "type": "module",
  "scripts": {
    "headers": "node ../../scripts/generate-headers.ts public",
    "dev": "npm run headers && astro dev --port 4321",
    "build": "node ../../scripts/assert-build-env.ts && npm run headers && astro build",
    "preview": "astro preview --port 4321",
    "types": "wrangler types --include-runtime=false --strict-vars=false",
    "typecheck": "astro check",
    "deploy:staging": "node ../../scripts/deploy-staging.ts public"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.8",
    "@cg/core": "*",
    "astro": "7.4.12"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "typescript": "6.0.3",
    "wrangler": "4.162.0"
  }
}
