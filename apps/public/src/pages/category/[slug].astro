---
/**
 * A category (PUB-07): breadcrumbs, subcategories (compact buttons), and its
 * items, including those in subcategories (toggle with ?sub=0). Items show as
 * the vertical feed by default, or as a grid (?view=grid); owner feedback
 * 2026-11-24. Categories without any public item give the standard 404.
 */
import { env } from 'cloudflare:workers';
import {
  categoryTrail,
  listContextCards,
  listContextItems,
  listPublicCategories,
  markdownToText,
  renderMarkdown,
  type ListContext,
} from '@cg/core/public';
import Base from '../../layouts/Base.astro';
import CardGrid from '../../components/CardGrid.astro';
import FeedList from '../../components/FeedList.astro';
import Pager from '../../components/Pager.astro';
import ViewSwitch from '../../components/ViewSwitch.astro';
import {
  FEED_PAGE_SIZE,
  PAGE_SIZE,
  contextQuery,
  pageFromUrl,
  viewFromUrl,
} from '../../lib/context.ts';
import { mediaUrl } from '../../lib/images.ts';

const slug = String(Astro.params['slug']);
const all = await listPublicCategories(env.DB);
const category = all.find((c) => c.slug === slug);
if (!category) return new Response(null, { status: 404 });

const descendants = Astro.url.searchParams.get('sub') !== '0';
const context: ListContext = { kind: 'category', slug, descendants };
const view = viewFromUrl(Astro.url, 'feed');
const page = pageFromUrl(Astro.url);
const size = view === 'feed' ? FEED_PAGE_SIZE : PAGE_SIZE;
const offset = (page - 1) * size;
const children = all.filter((c) => c.parentSlug === slug);

const grid = view === 'grid' ? await listContextCards(env.DB, context, offset, size) : null;
const feed = view === 'feed' ? await listContextItems(env.DB, context, offset, size) : null;
const total = grid?.total ?? feed?.total ?? 0;
const shown = grid?.cards.length ?? feed?.items.length ?? 0;
if (shown === 0 && page > 1) return new Response(null, { status: 404 });

const og = grid?.cards[0]?.cover?.og ?? feed?.items[0]?.media[0]?.og ?? null;
const ogAlt = grid?.cards[0]?.cover?.alt ?? feed?.items[0]?.media[0]?.alt ?? category.name;
const trail = categoryTrail(all, slug);
const self = `/category/${encodeURIComponent(slug)}`;
const keep = view === 'grid' ? '?view=grid' : '';
const description = category.description
  ? markdownToText(category.description)
  : `${category.name}: ${category.itemCount} item${category.itemCount === 1 ? '' : 's'}.`;
---

<Base
  title={category.name}
  description={description}
  canonical={self}
  image={og ? { url: mediaUrl(og.key), width: og.width, height: og.height, alt: ogAlt } : null}
>
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <ol>
      <li>
        <a href="/">Home</a>
      </li>
      <li>
        <a href="/collections">Collections</a>
      </li>
      {trail.map((step, i) => (
        <li>
          {i === trail.length - 1 ? (
            <span aria-current="page">{step.name}</span>
          ) : (
            <a href={`/category/${encodeURIComponent(step.slug)}`}>{step.name}</a>
          )}
        </li>
      ))}
    </ol>
  </nav>
  <h1>{category.name}</h1>
  {category.description && <div class="prose" set:html={renderMarkdown(category.description)} />}

  {children.length > 0 && (
    <nav class="chips" aria-label="Subcategories">
      <ul>
        {children.map((c) => (
          <li>
            <a href={`/category/${encodeURIComponent(c.slug)}${keep}`}>
              {c.name} <span class="chip-count">{c.itemCount}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )}

  <section aria-labelledby="items-h">
    <div class="list-head">
      <h2 id="items-h" class="list-count">
        {total} item{total === 1 ? '' : 's'}
        {children.length > 0 &&
          (descendants ? ', including subcategories' : ' filed directly here')}
      </h2>
      <ViewSwitch view={view} defaultView="feed" />
    </div>
    {children.length > 0 && (
      <p class="muted small">
        {descendants ? (
          <a href={`${self}?sub=0${view === 'grid' ? '&view=grid' : ''}`}>
            Only items filed directly here
          </a>
        ) : (
          <a href={`${self}${keep}`}>Include subcategories</a>
        )}
      </p>
    )}
    {shown === 0 && <p class="muted">No items filed directly here.</p>}
    {grid && grid.cards.length > 0 && (
      <CardGrid cards={grid.cards} context={context} eagerCount={4} />
    )}
    {feed && feed.items.length > 0 && (
      <FeedList
        items={feed.items}
        context={context}
        offset={offset}
        total={total}
        contextQuery={contextQuery(context)}
      />
    )}
    <Pager page={page} total={total} pageSize={size} feed={view === 'feed'} />
  </section>
</Base>

<script>
  import '../../scripts/feed.ts';
</script>
