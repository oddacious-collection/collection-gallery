---
/**
 * One item as shown on its page and in the vertical feed (PUB-04, PUB-05):
 * the carousel of photos and videos (PUB-06), then title, date, description,
 * categories and tags.
 *
 * The carousel works without JavaScript (swipe/scroll with snapping; each
 * photo links to its full-screen view); scripts/feed.ts adds arrows, dots,
 * keyboard control and the feed itself.
 */
import { renderMarkdown, type ListContext, type PublicItemDetail } from '@cg/core/public';
import { itemHref } from '../lib/context.ts';
import { formatDate } from '../lib/site.ts';
import Photo from './Photo.astro';
import VideoSlide from './VideoSlide.astro';

interface Props {
  item: PublicItemDetail;
  context: ListContext;
  /** The item page's own item is the h1; items added by the feed are h2. */
  headingLevel: 1 | 2;
  eager?: boolean;
}
const { item, context, headingLevel, eager = false } = Astro.props;
const Heading = headingLevel === 1 ? 'h1' : 'h2';
const headingId = `t-${item.slug}`;
const many = item.media.length > 1;
const hasVideo = item.media.some((m) => m.video !== null);
const kindOf = (m: (typeof item.media)[number]) => (m.video ? 'Video' : 'Photo');
const viewHref = (i: number) => `/item/${encodeURIComponent(item.slug)}/photo/${i + 1}`;
const SIZES = '(min-width: 46rem) 44rem, 100vw';
---

<article
  class="item"
  data-item
  data-slug={item.slug}
  data-url={itemHref(item.slug, context)}
  data-title={item.title}
  aria-labelledby={headingId}
>
  {item.media.length > 0 && (
    <div class="carousel" data-carousel>
      <ul
        class="slides"
        aria-label={`${hasVideo ? 'Photos and videos' : 'Photos'} of ${item.title}`}
        tabindex="0"
      >
        {item.media.map((img, i) => (
          <li
            class="slide"
            aria-label={many ? `${kindOf(img)} ${i + 1} of ${item.media.length}` : undefined}
          >
            {img.video ? (
              <VideoSlide
                image={img}
                video={img.video}
                href={viewHref(i)}
                name={`Video ${i + 1}`}
                sizes={SIZES}
                eager={eager && i === 0}
              />
            ) : (
              <a href={viewHref(i)} aria-label={`View photo ${i + 1} full screen`}>
                <Photo image={img} sizes={SIZES} eager={eager && i === 0} />
              </a>
            )}
          </li>
        ))}
      </ul>
      {many && (
        <>
          <button
            type="button"
            class="carousel-btn prev"
            data-prev
            aria-label={hasVideo ? 'Previous' : 'Previous photo'}
            hidden
          >
            ‹
          </button>
          <button
            type="button"
            class="carousel-btn next"
            data-next
            aria-label={hasVideo ? 'Next' : 'Next photo'}
            hidden
          >
            ›
          </button>
          <p class="carousel-count" data-count aria-live="polite">
            1 / {item.media.length}
          </p>
        </>
      )}
    </div>
  )}
  <div class="item-text">
    <Heading id={headingId} class="item-title">
      {headingLevel === 1 ? item.title : <a href={itemHref(item.slug, context)}>{item.title}</a>}
    </Heading>
    {item.postedAt && (
      <p class="item-date">
        <time datetime={item.postedAt}>{formatDate(item.postedAt)}</time>
      </p>
    )}
    {item.description && (
      <div class="prose" set:html={renderMarkdown(item.description, { headingBase: 3 })} />
    )}
    {item.categories.length > 0 && (
      <ul class="item-cats" aria-label="Categories">
        {item.categories.map((c) => (
          <li>
            {c.trail.map((step, i) => (
              <>
                {i > 0 && <span aria-hidden="true"> › </span>}
                <a href={`/category/${encodeURIComponent(step.slug)}`}>{step.name}</a>
              </>
            ))}
          </li>
        ))}
      </ul>
    )}
    {item.tags.length > 0 && (
      <ul class="item-tags" aria-label="Tags">
        {item.tags.map((t) => (
          <li>
            <a href={`/search?q=${encodeURIComponent(t)}`}>#{t}</a>
          </li>
        ))}
      </ul>
    )}
  </div>
</article>
